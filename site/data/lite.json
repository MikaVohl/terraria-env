{
  "_note": "Terraria-Lite track. Entries with a 'ref' take their numbers from generated files: 'rl:final/<key>' and 'rl:run/<id>' from data/rl.json, 'llm:<study>/<harness>' from data/llm.json. Entries with placeholder: true are invented to show the layout.",
  "contract": {
    "summary": "RL and LLM agents get the same symbolic observation (11x9 local tile, light and entity window, inventory, status, earned achievements), the same legal-action mask and the same scorer. LLMs additionally receive the public rules and recipes as text.",
    "observation": "11x9 local view: tile ids, light, visible mobs; inventory (sqrt(count/999) encoding), equipment, cooldowns, achievement bits. Darkness hides terrain and mobs.",
    "actions": "83 discrete primitive actions (move, jump, mine/place in 20 reach cells, craft each recipe, select, attack, heal, climb). Masks encode physical legality, not strategy.",
    "horizon": "3,000 primitive actions per episode (v7/v8); 10,000 in the v9 draft.",
    "score_v8": "Achievements unlocked, out of 32 (equal weight). IQM over training seeds with a bootstrap 95% CI.",
    "score_v9": "Percent of the maximum weighted score (tiers weighted 1/3/5/8, max 129).",
    "llm_rules": "Primitive or open-loop lists of up to 16 primitive actions per call; every action costs a tick; illegal actions still cost a tick; no tools, code execution, map or hidden state; notes and history are declared scaffold settings.",
    "same_information": true
  },
