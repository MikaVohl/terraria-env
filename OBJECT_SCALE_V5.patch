+/* Footprint correctness fixtures, never demonstrations or learner input. */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "env.h"
+
+static void flat(Env *e) {
+ env_init(e,(EnvConfig){3000});env_reset(e,7);
+ memset(e->tiles,0,sizeof e->tiles);memset(e->object_part,0,sizeof e->object_part);
+ memset(e->mobs,0,sizeof e->mobs);memset(e->chests,0,sizeof e->chests);e->chest_count=0;
+ for(int x=0;x<WORLD_W;x++) { e->surface[x]=40;e->tiles[40][x]=TILE_STONE; }
+ e->px=40;e->py=39;e->terrain_dirty=true;light_recompute(e);
+}
+static void oracle(Env *e) {
+ light_recompute(e);Env other=*e;light_reference(&other);assert(!memcmp(other.light,e->light,sizeof e->light));
+}
+static void footprint(const Env *e,Tile t,int left,int bottom) {
+ int w=tile_object_w(t),h=tile_object_h(t);
+ for(int row=0;row<h;row++) for(int col=0;col<w;col++) {
+  assert(tile_at(e,left+col,bottom-h+1+row)==t);
+  assert(e->object_part[bottom-h+1+row][left+col]==row*w+col);
+ }
+}
+int main(void) {
+ assert(tile_object_w(TILE_CHEST)==2&&tile_object_h(TILE_CHEST)==2);
+ assert(tile_object_w(TILE_LIFE_CRYSTAL)==2&&tile_object_h(TILE_LIFE_CRYSTAL)==2);
+ assert(tile_object_w(TILE_FURNACE)==3&&tile_object_h(TILE_FURNACE)==2);
+ assert(tile_object_w(TILE_CAMPFIRE)==3&&tile_object_h(TILE_CAMPFIRE)==2);
+ assert(tile_object_w(TILE_WORKBENCH)==2&&tile_object_h(TILE_WORKBENCH)==1);
+ assert(tile_object_w(TILE_ANVIL)==2&&tile_object_h(TILE_ANVIL)==1);
+ Env e;uint8_t mask[ACT_COUNT];Obs obs;
+ flat(&e);e.selected=6;e.inv[ITEM_FURNACE]=1;
+ env_action_mask(&e,mask);assert(mask[ACT_PLACE_BODY_FOOT_LEFT]);
+ env_step(&e,ACT_PLACE_BODY_FOOT_LEFT);assert(e.inv[ITEM_FURNACE]==0);footprint(&e,TILE_FURNACE,40,39);oracle(&e);
+ flat(&e);e.selected=6;e.inv[ITEM_FURNACE]=1;e.tiles[38][42]=TILE_STONE;e.terrain_dirty=true;light_recompute(&e);
+ env_action_mask(&e,mask);assert(!mask[ACT_PLACE_BODY_FOOT_LEFT]);
+ e.light[38][42]=0;env_action_mask(&e,mask);assert(mask[ACT_PLACE_BODY_FOOT_LEFT]);
+ env_step(&e,ACT_PLACE_BODY_FOOT_LEFT);assert(e.inv[ITEM_FURNACE]==1&&tile_at(&e,40,39)==TILE_AIR);
+ flat(&e);e.px=WORLD_W-PLAYER_W;e.selected=6;e.inv[ITEM_FURNACE]=1;
+ env_action_mask(&e,mask);assert(!mask[ACT_PLACE_BODY_FOOT_LEFT]);
+ flat(&e);e.py=2;e.selected=6;e.inv[ITEM_FURNACE]=1;
+ env_action_mask(&e,mask);assert(!mask[ACT_PLACE_HEAD_LEFT]);
+ /* Every crystal quadrant breaks the whole object and drops exactly one. */
+ for(int part=0;part<4;part++) {
+  flat(&e);assert(env_object_write(&e,TILE_LIFE_CRYSTAL,42,39));e.px=40+part%2;
+  env_step(&e,part<2?ACT_MINE_MIDDLE_RIGHT:ACT_MINE_FOOT_RIGHT);
+  assert(e.inv[ITEM_LIFE_CRYSTAL]==1);
+  for(int y=38;y<=39;y++) for(int x=42;x<=43;x++) assert(tile_at(&e,x,y)==TILE_AIR);
+  while(e.mine_cd) env_step(&e,ACT_NOOP);
+  env_step(&e,ACT_MINE_FOOT_RIGHT);assert(e.inv[ITEM_LIFE_CRYSTAL]==1);oracle(&e);
+ }
+ flat(&e);env_object_write(&e,TILE_WORKBENCH,42,39);env_object_write(&e,TILE_WORKBENCH,44,39);e.px=41;
+ env_step(&e,ACT_MINE_FOOT_RIGHT);assert(e.inv[ITEM_WORKBENCH]==1);footprint(&e,TILE_WORKBENCH,44,39);
+ assert(tile_at(&e,42,39)==TILE_AIR&&tile_at(&e,43,39)==TILE_AIR);
+ flat(&e);env_object_write(&e,TILE_WORKBENCH,42,39);e.px=43;e.py=38;
+ env_step(&e,ACT_NOOP);assert(e.py==38);env_step(&e,ACT_DROP);assert(e.py==39);
+ flat(&e);env_object_write(&e,TILE_FURNACE,42,39);env_step(&e,ACT_RIGHT);assert(e.px==41);
+ flat(&e);env_object_write(&e,TILE_FURNACE,35,39);e.inv[ITEM_COPPER_ORE]=3;
+ env_action_mask(&e,mask);assert(mask[ACT_SMELT_COPPER]);env_step(&e,ACT_SMELT_COPPER);assert(e.inv[ITEM_COPPER_BAR]==1);
+ /* Visibility/proximity of any chest component works, not just its anchor. */
+ flat(&e);e.chest_count=1;e.chests[0].x=38;e.chests[0].y=39;e.chests[0].loot[ITEM_ROPE]=30;
+ env_object_write(&e,TILE_CHEST,38,39);oracle(&e);
+ for(int y=38;y<=39;y++) for(int x=38;x<=39;x++) e.light[y][x]=0;
+ env_action_mask(&e,mask);assert(!mask[ACT_INTERACT]);e.light[38][39]=DARK_THRESHOLD;
+ env_action_mask(&e,mask);assert(mask[ACT_INTERACT]);env_step(&e,ACT_INTERACT);
+ assert(e.inv[ITEM_ROPE]==30);footprint(&e,TILE_CHEST_OPEN,38,39);
+ env_step(&e,ACT_INTERACT);assert(e.inv[ITEM_ROPE]==30&&e.reward==0);oracle(&e);
+ flat(&e);env_object_write(&e,TILE_CAMPFIRE,42,39);int emitters=0;
+ for(int y=38;y<=39;y++) for(int x=42;x<=44;x++) emitters+=cell_emit(&e,x,y)>0;
+ assert(emitters==1);oracle(&e);env_step(&e,ACT_MINE_FOOT_RIGHT);
+ assert(e.inv[ITEM_CAMPFIRE]==1);oracle(&e);
+ flat(&e);env_object_write(&e,TILE_LIFE_CRYSTAL,42,39);env_obs(&e,&obs);
+ int count=0;for(int i=0;i<VIEW_CELLS;i++) {assert(obs.tile[i]<OBS_TILE_KINDS);count+=obs.tile[i]==TILE_LIFE_CRYSTAL;}
+ assert(count==4);
+ /* Valid complete footprints on generated worlds, not four independent hearts. */
+ for(int seed=0;seed<256;seed++) {
+  env_reset(&e,seed);int crystals=0,chests=0;
+  for(int y=0;y<WORLD_H;y++) for(int x=0;x<WORLD_W;x++) {
+   Tile t=tile_at(&e,x,y);int w=tile_object_w(t),h=tile_object_h(t);
+   if(w*h==1) continue;
+   int part=e.object_part[y][x];assert(part<w*h);
+   footprint(&e,t,x-part%w,y-part/w+h-1);
+   if(!part) {crystals+=t==TILE_LIFE_CRYSTAL;chests+=t==TILE_CHEST;}
+  }
+  assert(crystals==8&&chests==10&&body_fits(&e,e.px,e.py));
+  for(int i=0;i<e.chest_count;i++) for(int col=0;col<2;col++)
+   assert(tile_supports(tile_at(&e,e.chests[i].x+col,e.chests[i].y+1),false));
+ }
+ puts("v5 footprints: full placement/masks/darkness/bounds, atomic one-drop removal, adjacent-object isolation, stations, support, chest visibility/opening, lighting, unchanged observation taxonomy; 256 generated worlds passed");
+ return 0;
+}
